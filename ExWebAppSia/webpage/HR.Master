<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="HR.master.cs" Inherits="ExWebAppSia.webpage.HR" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>HR Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />

    <!-- Bootstrap CSS for modal -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Modern Theme CSS -->
    <link href="~/webpage/css/modern-theme.css" rel="stylesheet" type="text/css" />
    <!-- Custom Sidebar CSS -->
    <link href="<%= ResolveUrl("~/webpage/custom-css/mainsidebar.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/webpage/css/notifications.css") %>" rel="stylesheet" type="text/css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    
    <style>
        /* Fix logo background to be white */
        .sidebar-header {
            padding: 32px 24px;
            border-bottom: 1px solid #F0EEEE;
            background: white !important;
        }
        
        .sidebar-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 20px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(163, 106, 102, 0.12);
        }
        
        .logo-icon {
            height: 48px;
            width: auto;
            filter: drop-shadow(0 2px 8px rgba(163, 106, 102, 0.15));
            
        }
        
        
        }
    </style>
</head>
<body class="dashboard-body">
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />
        
        <!-- Sidebar Overlay for Mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        
        <div class="dashboard-wrapper">
            <!-- Sidebar -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <img src="../images/shessentials-logo.png" alt="Essentials Logo" class="logo-icon" />
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <!-- MAIN Section -->
                    <div class="nav-section">
                        <div class="nav-section-label">MAIN</div>
                        <ul class="nav-list">
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Dashboard.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                                    </svg>
                                    <span class="nav-text">Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Profile.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                    <span class="nav-text">Profile</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- MANAGEMENT Section -->
                    <div class="nav-section">
                        <div class="nav-section-label">MANAGEMENT</div>
                        <ul class="nav-list">
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Employee.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                    <span class="nav-text">Employee</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Attendance.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                                    </svg>
                                    <span class="nav-text">Attendance</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Announcement.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/>
                                    </svg>
                                    <span class="nav-text">Announcement</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Recruitment.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm8.94 2.14c-.46-.2-.95-.28-1.44-.28H15v2h4.5c.28 0 .5.22.5.5s-.22.5-.5.5H15v2h4.5c.28 0 .5.22.5.5s-.22.5-.5.5H15v2h4.5c1.1 0 2-.9 2-2v-3.5c0-.17-.02-.34-.06-.5zM12 14c-2.67 0-8 1.34-8 4v2h9v-2.18c-.85-.4-1.57-1.02-2.11-1.82H12v2h-8c0-1.86 3.6-3.1 7.1-3.6z"/>
                                    </svg>
                                    <span class="nav-text">Recruitment</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/Approvals.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-8 14l-4-4 1.41-1.41L11 14.17l5.59-5.59L18 10l-7 7z"/>
                                    </svg>
                                    <span class="nav-text">Approvals</span>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a runat="server" href="~/webpage/ActivityLog.aspx" class="nav-link">
                                    <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24">
                                        <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                                    </svg>
                                    <span class="nav-text">Activity Log</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </aside>

            <!-- Main Content Area -->
            <div class="main-content">
                <!-- Top Header -->
                <header class="top-header">
                    <div class="header-left">
                        <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle">
                            <i class="fas fa-bars"></i>
                        </button>
                        <!-- Search Bar -->
                        <!-- Top Header Search Bar Removed -->
                    </div>

                    <div class="header-right">
                        <div class="header-actions">
                            <!-- Dynamic Notification Button with Dropdown -->
                            <div class="notification-menu">
                                <button type="button" class="notification-btn" id="notificationBtn">
                                    <i class="far fa-bell"></i>
                                    <span class="notification-badge" id="unreadBadge" style="display: none;">0</span>
                                </button>
                                <div class="notification-dropdown" id="notificationDropdown">
                                    <div class="notification-header">
                                        <h3>Notifications</h3>
                                        <button type="button" class="mark-all-read" id="markAllRead">Mark all as read</button>
                                    </div>
                                    <div class="notification-list" id="notificationList">
                                        <!-- Notifications will be loaded here -->
                                        <div class="notification-empty">
                                            <i class="far fa-bell-slash"></i>
                                            <p>No notifications yet</p>
                                        </div>
                                    </div>
                                    <div class="notification-footer">
                                        <a href="#" class="view-all-notif">Show all updates</a>
                                    </div>
                                </div>
                            </div>

                            <!-- User Menu with Dropdown -->
                            <div class="user-menu">
                                <button class="user-menu-btn" id="userMenuBtn">
                                    <div class="user-avatar-small">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <i class="fas fa-chevron-down"></i>
                                </button>

                                <div class="dropdown-menu user-dropdown" id="userDropdown">
                                    <!-- Updated logout button to trigger modal -->
                                    <button type="button" class="dropdown-item" id="logoutTriggerBtn">
                                        <i class="fas fa-sign-out-alt"></i>
                                        Sign Out
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Simple Logout Confirmation Modal -->
                <div class="modal fade logout-modal" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-sm">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="logout-modal-icon">
                                    <i class="fas fa-sign-out-alt"></i>
                                </div>
                                <h5 class="logout-modal-title">Sign Out</h5>
                                <p class="logout-modal-text">Are you sure you want to sign out?</p>
                    
                                <div class="logout-modal-actions">
                                    <button type="button" class="btn logout-btn-cancel" data-bs-dismiss="modal">
                                        Cancel
                                    </button>
                                    <button type="button" class="btn logout-btn-confirm" id="confirmLogoutBtn">
                                        <span class="btn-text">Sign Out</span>
                                        <span class="btn-loading" style="display: none;">
                                            <i class="fas fa-spinner fa-spin"></i>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <!-- Global Alert Modal -->
    <div class="modal fade" id="globalAlertModal" tabindex="-1" aria-labelledby="globalAlertTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 15px 35px rgba(0,0,0,0.2); overflow: hidden;">
                <div class="modal-header" style="background: #A44F56; color: white; border: none; padding: 20px 24px;">
                    <h5 class="modal-title" id="globalAlertTitle" style="font-weight: 700; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-bell"></i> Notification
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center" style="padding: 40px 30px;">
                    <div id="globalAlertIcon" style="margin-bottom: 24px; font-size: 64px; color: #A44F56; animation: pulse 2s infinite;">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <p id="globalAlertMessage" style="font-size: 16px; color: #4B5563; line-height: 1.6; font-weight: 500; margin: 0;"></p>
                </div>
                <div class="modal-footer" style="border: none; padding: 0 30px 30px; justify-content: center;">
                    <button type="button" class="btn" data-bs-dismiss="modal" 
                        style="background: #A44F56; color: white; padding: 12px 50px; border-radius: 12px; font-weight: 700; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(164, 79, 86, 0.2);">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <style>
        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
            100% { transform: scale(1); opacity: 1; }
        }
        #globalAlertModal .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(164, 79, 86, 0.3);
            background: #8B4349;
        }
    </style>

    <!-- Bootstrap JS for modal functionality -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global Alert Override Script -->
    <script>
        // Store the original alert function
        const originalAlert = window.alert;

        // Override window.alert
        window.alert = function (message, title = "Notification") {
            const modalEl = document.getElementById('globalAlertModal');
            if (modalEl) {
                document.getElementById('globalAlertMessage').innerText = message;
                const titleEl = document.getElementById('globalAlertTitle');
                if (titleEl && title !== "Notification") {
                    titleEl.innerHTML = `<i class="fas fa-bell"></i> ${title}`;
                }
                
                // Use Bootstrap's modal instance
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            } else {
                // Fallback to original alert if modal element is not found
                originalAlert(message);
            }
        };
    </script>

    <!-- Custom JS for User Dropdown -->
    <script src="<%= ResolveUrl("~/custom-js/mainsidebar.js") %>"></script>
    <script src="<%= ResolveUrl("~/custom-js/notifications.js") %>"></script>
    
    <!-- SVG Icons Library -->
    <script src="../js/svg-icons.js"></script>
</body>
</html>