<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="EmployeeHR.master.cs" Inherits="ExWebAppSia.webpage_EmployeeViewpoint_.EmployeeHR" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Employee Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap CSS for modal -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Custom CSS -->
    <link href="<%= ResolveUrl("~/webpage/css/modern-theme.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/webpage/custom-css/mainsidebar.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/webpage/css/notifications.css") %>" rel="stylesheet" type="text/css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        /* Fix logo background to be white and match HR side */
        .sidebar-header {
            padding: 32px 24px;
            border-bottom: 1px solid #F0EEEE;
            background: white !important;
        }
        
        .sidebar-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 20px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(163, 106, 102, 0.12);
        }
        
        .logo-icon {
            height: 48px;
            width: auto;
            filter: drop-shadow(0 2px 8px rgba(163, 106, 102, 0.15));
        }

        /* Consistent search bar styling */
        .search-container {
            position: relative;
            flex: 1;
            max-width: 500px;
        }

        .search-bar {
            position: relative;
            display: flex;
            align-items: center;
            background: #F8F6F5;
            border-radius: 16px;
            padding: 0 16px;
            transition: all 0.3s ease;
        }

        .search-bar:focus-within {
            background: white;
            box-shadow: 0 0 0 3px rgba(163, 106, 102, 0.1);
        }

        .search-icon {
            color: #B8A19F;
            font-size: 18px;
        }

        .search-input {
            border: none;
            background: transparent;
            padding: 12px 16px;
            flex: 1;
            font-size: 14px;
            color: #4A3534;
            outline: none;
        }
    </style>
</head>
<body class="dashboard-body">
    <form id="form1" runat="server">
    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <img src="<%= ResolveUrl("~/images/shessentials-logo.png") %>" alt="Essentials Logo" class="logo-icon" />
                </div>
            </div>

            <nav class="sidebar-nav">
                <!-- MAIN Section -->
                <div class="nav-section">
                    <div class="nav-section-label">MAIN</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a runat="server" href="~/webpage(EmployeeViewpoint)/Dashboard.aspx" class="nav-link">
                                <i class="fas fa-chart-line"></i>
                                <span class="nav-text">Dashboard</span>
                            </a>
                        <li class="nav-item">
                            <a runat="server" href="~/webpage(EmployeeViewpoint)/Announcement.aspx" class="nav-link">
                                <i class="fas fa-bullhorn"></i>
                                <span class="nav-text">Announcement</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- MANAGEMENT Section -->
                <div class="nav-section">
                    <div class="nav-section-label">MANAGEMENT</div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a runat="server" href="~/webpage(EmployeeViewpoint)/Profile.aspx" class="nav-link">
                                <i class="fas fa-user"></i>
                                <span class="nav-text">Account</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>

            <!-- Main Content Area -->
            <div class="main-content">
                 <!-- Top Header -->
                <header class="top-header">
                <div class="header-left">
                    <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <!-- Search Bar -->
                    <!-- Top Header Search Bar Removed -->
                </div>

                <div class="header-right">
                    <div class="header-actions">
                        <!-- Dynamic Notification Button with Dropdown -->
                        <div class="notification-menu">
                            <button type="button" class="notification-btn" id="notificationBtn">
                                <i class="far fa-bell"></i>
                                <span class="notification-badge" id="unreadBadge" style="display: none;">0</span>
                            </button>
                            <div class="notification-dropdown" id="notificationDropdown">
                                <div class="notification-header">
                                    <h3>Notifications</h3>
                                    <button type="button" class="mark-all-read" id="markAllRead">Mark all as read</button>
                                </div>
                                <div class="notification-list" id="notificationList">
                                    <!-- Notifications will be loaded here -->
                                    <div class="notification-empty">
                                        <i class="far fa-bell-slash"></i>
                                        <p>No notifications yet</p>
                                    </div>
                                </div>
                                <div class="notification-footer">
                                    <a href="#" class="view-all-notif">Show all updates</a>
                                </div>
                            </div>
                        </div>

                        <!-- User Menu with Dropdown -->
                        <div class="user-menu">
                            <button class="user-menu-btn" id="userMenuBtn">
                                <div class="user-avatar-small">
                                        <i class="fas fa-user"></i>
                                </div>
                                <i class="fas fa-chevron-down"></i>
                            </button>

                            <div class="dropdown-menu user-dropdown" id="userDropdown">
                            <!-- Updated logout button to trigger modal -->
                            <button class="dropdown-item" id="logoutTriggerBtn">
                                <i class="fas fa-sign-out-alt"></i>
                                Sign Out
                            </button>
                        </div>
                        </div>

                    </div>
                </div>
            </header>

                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
        </div>

        <!-- Logout Confirmation Modal (Relocated for better visibility) -->
        <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
                <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
                    <div class="modal-header" style="background: #A44F56; height: 60px; border: none; position: relative;">
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" style="position: absolute; right: 20px; top: 20px; z-index: 10;"></button>
                    </div>
                    <div class="modal-body" style="padding: 40px 30px; text-align: center;">
                        <div style="width: 80px; height: 80px; background: #FFF5F5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: -80px auto 20px; position: relative; border: 4px solid white; box-shadow: 0 10px 20px rgba(164, 79, 86, 0.15);">
                            <i class="fas fa-sign-out-alt" style="font-size: 32px; color: #A44F56;"></i>
                        </div>
                        <h3 style="font-weight: 800; color: #1A202C; margin-bottom: 10px; font-size: 24px;">Sign Out</h3>
                        <p style="color: #718096; font-size: 16px; margin-bottom: 30px;">Are you sure you want to<br/>sign out?</p>
                        
                        <div style="display: flex; gap: 15px;">
                            <button type="button" class="btn" data-bs-dismiss="modal" style="flex: 1; padding: 12px; border-radius: 12px; background: #EDF2F7; color: #4A5568; font-weight: 700; border: none; transition: all 0.2s;">Cancel</button>
                            <button type="button" class="btn" id="confirmLogoutBtn" style="flex: 1; padding: 12px; border-radius: 12px; background: #A44F56; color: white; font-weight: 700; border: none; box-shadow: 0 4px 12px rgba(164, 79, 86, 0.3); transition: all 0.2s;">
                                <span class="btn-text">Sign Out</span>
                                <span class="btn-loading" style="display: none;">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Global Alert Modal -->
    <div class="modal fade" id="globalAlertModal" tabindex="-1" aria-labelledby="globalAlertTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 15px 35px rgba(0,0,0,0.2); overflow: hidden;">
                <div class="modal-header" style="background: #A44F56; color: white; border: none; padding: 20px 24px;">
                    <h5 class="modal-title" id="globalAlertTitle" style="font-weight: 700; display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-bell"></i> Notification
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center" style="padding: 40px 30px;">
                    <div id="globalAlertIcon" style="margin-bottom: 24px; font-size: 64px; color: #A44F56; animation: pulse 2s infinite;">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <p id="globalAlertMessage" style="font-size: 16px; color: #4B5563; line-height: 1.6; font-weight: 500; margin: 0;"></p>
                </div>
                <div class="modal-footer" style="border: none; padding: 0 30px 30px; justify-content: center;">
                    <button type="button" class="btn" data-bs-dismiss="modal" 
                        style="background: #A44F56; color: white; padding: 12px 50px; border-radius: 12px; font-weight: 700; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(164, 79, 86, 0.2);">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <style>
        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>

    <!-- Bootstrap JS for modal functionality -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global Alert Override Script -->
    <script>
        // Store the original alert function
        const originalAlert = window.alert;

        // Override window.alert
        window.alert = function (message, title = "Notification") {
            const modalEl = document.getElementById('globalAlertModal');
            if (modalEl) {
                document.getElementById('globalAlertMessage').innerText = message;
                const titleEl = document.getElementById('globalAlertTitle');
                if (titleEl && title !== "Notification") {
                    titleEl.innerHTML = `<i class="fas fa-bell"></i> ${title}`;
                }
                
                // Use Bootstrap's modal instance
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            } else {
                // Fallback to original alert if modal element is not found
                originalAlert(message);
            }
        };
    </script>

    <!-- Custom JS for User Dropdown -->
    <script src="<%= ResolveUrl("~/custom-js/mainsidebar.js") %>"></script>
    <script src="<%= ResolveUrl("~/custom-js/notifications.js") %>"></script>

</body>
</html>